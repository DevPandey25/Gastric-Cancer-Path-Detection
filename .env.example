# ===========================================================================
# GastricPath AI — Environment Configuration Template
# ===========================================================================
# Copy this file to .env and adapt to your local or deployment environment:
#   cp .env.example .env
#
# NOTE: This application operates entirely offline and requires ZERO API keys,
# cloud tokens, or third-party service credentials.
# ===========================================================================

# Application Environment (development, testing, production)
APP_ENV=production

# Server Binding
HOST=127.0.0.1
PORT=8000
WORKERS=1

# SQLite Database Location
DATABASE_URL=sqlite:///./gastric_path.db

# Storage Directories
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Baseline Model Configuration
MODEL_CHECKPOINT=models/checkpoints/gastric_rnn_classifier.pt
MINIMUM_CHECKPOINT_ACCURACY=0.80

# Histopathology Dataset Directory (Optional for inference; required for prototype retraining)
HISTOLOGY_DATASET_DIR=research/data/gchtid_sample

